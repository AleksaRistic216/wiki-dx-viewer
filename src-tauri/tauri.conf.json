{
  "productName": "Wiki DX Viewer",
  "version": "0.1.6",
  "identifier": "com.devexpress.wiki-dx-viewer",
  "build": {
    "frontendDist": "http://localhost:4000",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Wiki DX Viewer",
        "width": 1280,
        "height": 900,
        "center": true,
        "url": "http://localhost:4000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/**/*"],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
